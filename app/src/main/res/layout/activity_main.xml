<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E0F7FA"
            android:padding="20dp"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvContador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pasos de hoy: 0"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">
                <Button
                    android:id="@+id/btnSumar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sumar paso"
                    android:layout_marginEnd="10dp"/>
                <Button
                    android:id="@+id/btnDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ir al detalle" />
            </LinearLayout>

            <!-- Boton de reinicio -->
            <Button
                android:id="@+id/btnReiniciar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reiniciar pasos"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FF5252" /> <!-- Color rojo -->
        </LinearLayout>

        <!-- Lista de Actividades -->
        <CheckBox
            android:id="@+id/cbPasos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pasos Diarios\nPendiente de completar"
            android:background="#FFFFFF"
            android:padding="15dp"
            android:layout_marginBottom="10dp"/>

        <CheckBox
            android:id="@+id/cbNatacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Natación\nPendiente de completar"
            android:background="#FFFFFF"
            android:padding="15dp"
            android:layout_marginBottom="10dp"/>

        <CheckBox
            android:id="@+id/cbFuerza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rutina de Fuerza\nPendiente de completar"
            android:background="#FFFFFF"
            android:padding="15dp"
            android:layout_marginBottom="10dp"/>

        <CheckBox
            android:id="@+id/cbBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sesión de Box\nPendiente de completar"
            android:background="#FFFFFF"
            android:padding="15dp"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>
</ScrollView>